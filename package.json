{
  "name": "@wireio/wirejs-native",
  "version": "0.0.1",
  "description": "Talk to Wire API",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "npm run build",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "build": "rimraf dist && tsc -p ./tsconfig.json && node scripts/copy-ripe-md.js",
    "build-web": "webpack --config webpack.prod.js && webpack --config webpack.debug.js",
    "build-production": "yarn build && yarn build-web && yarn test-all",
    "docs-init": "sh .docs/scripts/init.sh",
    "docs-build": "sh .docs/scripts/build.sh",
    "docs-serve": "python -m SimpleHTTPServer",
    "docs-publish": "sh .docs/scripts/publish.sh"
  },
  "author": "block.one",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wire-Network/wirejs-native.git"
  },
  "dependencies": {
    "bn.js": "5.2.0",
    "elliptic": "^6.6.1",
    "hash.js": "1.1.7",
    "pako": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/elliptic": "^6.4.13",
    "@types/jest": "^26.0.24",
    "@types/node": "^14.17.5",
    "@types/node-fetch": "^2.5.11",
    "@types/pako": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "buffer": "^6.0.3",
    "clean-webpack-plugin": "^3.0.0",
    "crypto-browserify": "^3.12.0",
    "cypress": "^14.5.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "jest": "^30.0.5",
    "jest-extended": "^6.0.0",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^3.5.3",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.2.3",
    "typescript": "^4.3.5",
    "typescript-eslint": "^8.26.1",
    "webpack": "^5.44.0",
    "webpack-cli": "^4.7.2"
  },
  "bugs": {
    "url": "https://github.com/Wire-Network/wirejs-native/issues"
  },
  "homepage": "https://github.com/Wire-Network/wirejs-native#readme",
  "directories": {
    "doc": "docs"
  }
}
